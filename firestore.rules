rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: verifica si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Colección de servicios (precios de servicios)
    // Solo usuarios autenticados pueden leer y escribir
    match /services/{serviceId} {
      allow read, write: if isAuthenticated();
    }
    
    // Colección de transacciones (cobranzas)
    // Solo usuarios autenticados pueden leer y crear
    // No se permite editar o eliminar transacciones para mantener integridad
    match /transactions/{transactionId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false; // Prevenir modificación de registros
    }
    
    // Colección de gastos
    // Solo usuarios autenticados pueden leer y crear
    match /expenses/{expenseId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false; // Prevenir modificación de registros
    }
    
    // Colección de clientes
    // Solo usuarios autenticados pueden leer, crear y eliminar
    match /clients/{clientId} {
      allow read, create, delete: if isAuthenticated();
      allow update: if isAuthenticated();
    }
    
    // Configuraciones generales (operadores, etc.)
    match /settings/{settingId} {
      allow read, write: if isAuthenticated();
    }
    
    // Denegar acceso a cualquier otra colección no especificada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
